# Run npm run setup to generate local credentials. Never commit real values.
ADMIN_PASSWORD=
SESSION_SECRET=
APP_URL=http://localhost:3004
# Local persistent database; for Vercel, use a remote libsql:// URL and token.
DATABASE_URL=file:data/cotizador.db
DATABASE_AUTH_TOKEN=
# Vercel's native Turso integration provides these instead.
# In Vercel, omit DATABASE_URL above so it does not override the remote URL.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
